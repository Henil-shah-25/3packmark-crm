# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# secrets & keys
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
client_secret*.json

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (strictly ignore all .env variants except example)
.env
.env.*
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
scratch/
.agents/

# runtime data
data/*.json
data/auth-lockout.json
data/google-credentials.json
data/auth-revocations.json
data/pulse-storage.json
data/crm-storage.json
data/ai-chats.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
