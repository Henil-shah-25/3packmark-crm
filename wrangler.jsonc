{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3packmark-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "upload_source_maps": false
}
